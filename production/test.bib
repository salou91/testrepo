@ARTICLE{Weisfelt-Sasa-lh,
  title       = "{Bacterial meningitis: a review of effective pharmacotherapy}",
  author      = "Weisfelt, Martijn and de Gans, Jan and van de Beek, Diederik",
  affiliation = "Academic Medical Centre, Department of Neurology, Centre of
