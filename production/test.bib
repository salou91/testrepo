@INPROCEEDINGS{Bo-Sasa-id,
  title     = "{Research on the application of multimodal sensing technology in
               surveying and mapping data collection}",
  author    = "Bo, Liu and Jianying, Weng",
  booktitle = "{2025 IEEE 5th International Conference on Power, Electronics and
               Computer Applications (ICPECA)}",
  publisher = "IEEE",
  abstract  = "This paper proposes an innovative CNN and RNN fusion algorithm to
               optimize the application of multimodal sensing technology in
               surveying and mapping data collection. The algorithm combines the
               data of multiple sensors such as lidar, RGB camera and infrared
               sensor, uses CNN to extract the spatial features of the image,
               and uses RNN to analyze the temporal relationship between
               different modal data, so as to achieve efficient fusion of
               multimodal data. Experimental results show that the proposed
               algorithm improves the data accuracy by about 18\% in multiple
               surveying and mapping scenarios compared with the traditional
               single-modal sensor method, and the processing efficiency is
               improved by 15\%. In addition, the algorithm shows significant
               robustness in complex environments, can effectively cope with the
               challenges brought by environmental changes, and improves the
               accuracy and stability of data. The research in this paper
               provides technical support for the development of intelligent
               surveying and mapping systems and promotes the popularization of
               multimodal data fusion algorithms in practical applications.",
  year      =  2025,
  doi       = "10.1109/icpeca63937.2025.10928820"
}

