@ARTICLE{Delaney-Sasa-mw,
  title     = "{Long-range DNA charge transport}",
  author    = "Delaney, Sarah and Barton, Jacqueline K",
  journal   = "The Journal of organic chemistry",
  publisher = "American Chemical Society (ACS)",
  abstract  = "The stack of base pairs within double helical DNA has been shown
