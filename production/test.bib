@ARTICLE{Phillips-Sasa-ov,
  title       = "{Bacterial meningitis in children and adults. Changes in
                 community-acquired disease may affect patient care}",
  author      = "Phillips, E J and Simor, A E",
  affiliation = "Sunnybrook Health Science Centre, Ontario, Canada.
                 andrew.simor@sunnybrook.on.ca",
  journal     = "Postgraduate medicine",
  publisher   = "Informa UK Limited",
  abstract    = "Despite improved understanding of how bacterial meningitis
                 develops, the infection remains a potentially life-threatening
                 emergency capable of causing significant morbidity and
                 mortality. Since the introduction and widespread use of H
                 influenzae type b vaccine in infancy and childhood in North
