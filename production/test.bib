@ARTICLE{Furlan-Sasa-kd,
  title     = "{Slovene dialectal hapax legomenon \textit{me\v{z}ek} `young
               bear' and Slavic *\textit{me\v{c}ьkъ} `bear'}",
  author    = "Furlan, Metka",
  journal   = "Journal of Linguistics/Jazykovedn\'{y} casopis",
  publisher = "Walter de Gruyter GmbH",
  abstract  = "Abstract In the paper, the Slovenian dialect hapax legomenon
               mə\v{z}ә̏k `young bear', which was only attested in a narrow area
               of the Gorenjsko dialect, is related and explained from
               South-Slavic *me\v{c}ь̀kъ `bear' (= Serbian dial. m\'{e}ː\v{c}ak,
               Macedonian dial. me\v{c}\`{o}k). The regularly expected phonetic
               development from *me\v{c}ь̀kъ would be reflected as Slovenian
               *me\v{c}ә̏k, therefore, the Gorenjsko mə\v{z}ә̏k belongs to those
               lexemes which have undergone non-systematic and sporadic phonetic
               changes. In the paper, it was not possible to give an unequivocal
               answer to the question of the etymology of the word family
               *me\v{c}ь̀kъ : *m\`{e}\v{c}ьka : *me\v{c}ь̀cь with the starting
               point in the noun *m\`{e}ka f `bear', because *m\`{e}ka could be
               a hypocoristic for
               *medu{\fontencoding{LECO}\selectfont\char207}\v{e}̋dь `bear' or a
               deverbative from *me-ka-ti of onomatopoeic origin.",
  year      =  2024,
  doi       = "10.2478/jazcas-2024-0035"
}

@ARTICLE{Kotar-Sasa-gr,
  title     = "{Medieval foundations for the development of the modern Slovenian
               nation and national identity}",
  author    = "Kotar, Jernej",
  journal   = "Kronika (Ljubljana, Slovenia)",
  publisher = "Zveza zgodovinskih drustev Slovenije",
  abstract  = "Although the Slovenian nation did not exist in the Middle Ages,
               it was this nearly thousand-year-long period that witnessed the
               gradual formation of certain foundations for its subsequent
               development. Among these was, first and foremost, the
               geographical area of the Slovenian linguistic community which was
               formed once the state border was settled between the Holy Roman
               Empire and the Kingdom of Hungary and once the systematic
               medieval colonization came to an end. These two processes were
               also closely linked to the genesis of the Slovenian language,
               which dates back to the High Middle Ages. However, still older
               roots pertain to Christianity, the adoption of which brought
               about profound religious and social changes, coupled with
               political and cultural affiliation of Slovenian territory to the
               European West. The article focuses on presenting the
               above-mentioned three foundations and their part in the formation
               of the modern Slovenian nation and national identity.",
  year      =  2024,
  doi       = "10.56420/kronika.72.3.02"
}

