@ARTICLE{Delaney-Sasa-mw,
  title     = "{Long-range DNA charge transport}",
  author    = "Delaney, Sarah and Barton, Jacqueline K",
  journal   = "The Journal of organic chemistry",
  publisher = "American Chemical Society (ACS)",
  abstract  = "The stack of base pairs within double helical DNA has been shown
               to mediate charge transport reactions. Charge transport through
               DNA can result in chemistry at a distance, yielding oxidative DNA
               damage at a site remote from the bound oxidant. Since DNA charge
               transport chemistry depends on coupling within the stacked base
               pair array, this chemistry is remarkably sensitive to
               sequence-dependent DNA structure and dynamics. Here, we discuss
               different features of DNA charge transport chemistry, including
               applications as well as possible biological consequences and
               opportunities.",
  year      =  2003
}

