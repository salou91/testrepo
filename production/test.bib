@ARTICLE{Amjad-Sasa-jy,
  title     = "{A precise characterisation of the top quark electro-weak
               vertices at the ILC}",
  author    = "Amjad, M S and Bilokin, S and Boronat, M and Doublet, P and
               Frisson, T and Garc\'{\i}a, I Garc\'{\i}a and Perell\'{o}, M and
               P{\"{o}}schl, R and Richard, F and Ros, E and Rou{\"{e}}n\'{e}, J
               and Femenia, P Ruiz and Vos, M",
  journal   = "The European physical journal. C, Particles and fields",
  publisher = "Springer Science and Business Media LLC",
  abstract  = "Top quark production in the process
               $$e\textasciicircum+e\textasciicircum- \rightarrow
               t\bar{t}$$e+e-$\rightarrow{}$tt\textasciimacron{} at a future
               linear electron positron collider with polarised beams is a
               powerful tool to determine indirectly the scale of new physics.
               The presented study, based on a detailed simulation of the ILD
               detector concept, assumes a centre-of-mass energy of $$ \sqrt{s}
               =500$$s=500 GeV and a luminosity of $$\mathcal {L}=500\, \text{
               fb }\textasciicircum{-1} $$L=500fb-1 equally shared between the
               incoming beam polarisations of $$
               \mathcal{P}\_{e\textasciicircum-} ,
               \mathcal{P}\_{e\textasciicircum+} =\pm 0.8,\mp
               0.3$$Pe-,Pe+=$\pm{}$0.8,$\mp{}$0.3. Events are selected in which
               the top pair decays semi-leptonically and the cross sections and
               the forward--backward asymmetries are determined. Based on these
               results, the vector, axial vector and tensorial CP conserving
               couplings are extracted separately for the photon and the
               $$Z\textasciicircum0$$Z0 component. With the expected precision,
               a large number of models in which the top quark acts as a
               messenger to new physics can be distinguished with many standard
               deviations. This will dramatically improve expectations from e.g.
               the LHC for electro-weak couplings of the top quark.",
  year      =  2015,
  doi       = "10.1140/epjc/s10052-015-3746-5"
}

