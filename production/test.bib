@BOOK{Pearl-Sasa-kz,
  title     = "{A question of time: Freud in the light of heidegger's
               temporality}",
  author    = "Pearl, Joel",
  publisher = "Editions Rodopi B.V",
  abstract  = "In A Question of Time, Joel Pearl offers a new reading of the
