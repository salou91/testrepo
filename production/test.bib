@ARTICLE{Yue2026-gb,
  title     = "{Circadian rhythm-related miR-6883-5p suppresses
               enzalutamide-resistant prostate cancer}",
  author    = "Yue, Wenchang and Li, Chao and Wang, Tao and You, Jiawei and Sun,
